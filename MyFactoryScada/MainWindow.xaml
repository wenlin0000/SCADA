<Window x:Class="MyFactoryScada.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="智慧工廠 SCADA 戰情監控系統" Height="720" Width="1280"
        Background="#12151C" Foreground="#E2E8F0">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- 頂部狀態列 -->
            <RowDefinition Height="140"/>
            <!-- 關鍵 KPI 數據卡片 -->
            <RowDefinition Height="*"/>
            <!-- 即時動態曲線圖與控制區 -->
        </Grid.RowDefinitions>

        <!-- 1. 頂部標題與 PLC 連線狀態燈 -->
        <Border Grid.Row="0" Background="#1E232E" CornerRadius="8" Padding="16,0" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="🏭 A1 產線主軸設備監控戰情室" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 動態連線狀態燈號 -->
                    <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/>
                                <!-- 斷線紅燈 -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                        <Setter Property="Fill" Value="#10B981"/>
                                        <!-- 連線綠燈 -->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="PLC 通訊狀態" VerticalAlignment="Center" FontSize="14"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. 關鍵 KPI 數據卡片區 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <!-- 實際轉速卡片 -->
            <Border Background="#1E232E" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="主軸實際轉速 (RPM)" Foreground="#94A3B8" FontSize="14"/>
                    <TextBlock Text="{Binding ActualSpeed, StringFormat={}{0} RPM}" 
                               FontSize="36" FontWeight="Bold" Foreground="#38BDF8" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 機台溫度卡片 -->
            <Border Background="#1E232E" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="馬達繞組溫度 (°C)" Foreground="#94A3B8" FontSize="14"/>
                    <TextBlock Text="{Binding Temperature, StringFormat={}{0} °C}" 
                               FontSize="36" FontWeight="Bold" Foreground="#FBBF24" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 遠端參數控制卡片 -->
            <Border Background="#1E232E" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="遠端目標轉速設定" Foreground="#94A3B8" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Text="{Binding InputTargetSpeed, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="36" 
                                 FontSize="18" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="#0F172A" Foreground="White" BorderBrush="#334155"/>
                        <Button Content="下發指令" Command="{Binding SendSpeedCommandCommand}" 
                                Width="100" Height="36" Margin="12,0,0,0"
                                Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. 即時動態趨勢曲線圖 (ScottPlot) -->
        <Border Grid.Row="2" Background="#1E232E" CornerRadius="8" Padding="12">
            <ScottPlot:WpfPlot x:Name="TrendPlot"/>
        </Border>
    </Grid>
</Window>
